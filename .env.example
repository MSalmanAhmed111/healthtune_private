# General environment settings
ENVIRONMENT="development"          # Set the environment, e.g., development, staging, production
PORT=3000                           # Port for the application to run on
APP_PREFIX="/api"                   # Prefix for API routes
APP_NAME="Health Tune"              # Application name for general use in logs/messages
DOC_PREFIX="/doc/api"               # Route prefix for API documentation

# Database configuration
DB_HOST="localhost"                 # Database server hostname or IP address
DB_PORT=5432                        # Port number on which the database server is running
DB_USER="postgres"                  # Username for database access
DB_PASS="your_database_password"    # Password for database access
DB_NAME="your_database_name"        # Name of the specific database to connect to

# Authentication
AT_KEY="your_secret_key"            # Secret key for signing authentication tokens
AT_EXPIRY="2d"                      # Expiry duration for authentication tokens (e.g., "2d" for 2 days)

# Email server settings
EMAIL_HOST="smtp.your-email.com"    # SMTP server hostname for email service
EMAIL_PORT=587                      # SMTP server port
EMAIL_USER="your_email@example.com" # Username or email address for SMTP authentication
EMAIL_PASS="your_email_password"    # Password or key for SMTP authentication

# File storage
STORAGE_PROVIDER="local"            # File storage provider, e.g., "local", "s3", "gcs"
STORAGE_PATH="./media"              # Path for local file storage